# .env.example
# Copy to .env and fill in real values. Never commit the real .env file.

# ---- Database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=videotoshorts
# Full connection string used by the backend. In docker-compose this is
# derived automatically from the POSTGRES_* vars above if left unset; set it
# explicitly for local (non-docker) development, e.g.:
# postgresql://postgres:change-me@localhost:5432/videotoshorts
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/videotoshorts

# ---- Auth / JWT -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Third-party media APIs (B-roll sourcing) -------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Transcription / speech-to-text ------------------------------------------
TRANSCRIPTION_API_KEY=

# ---- Object storage (uploaded videos, generated clips, exports) --------------
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- Background task queue (RQ + Redis) --------------------------------------
# Leave unset (default) to run video-processing/render jobs via FastAPI's
# own BackgroundTasks instead -- no Redis needed for local development.
# REQUIRED in production: without it, ffmpeg renders run inside the API
# process and are lost if it restarts mid-encode.
REDIS_URL=

# ---- Render / export quality --------------------------------------------------
# Defaults match YouTube's recommended Shorts upload spec (1080x1920, 30fps,
# H.264 High, AAC 192k @ 48kHz, -14 LUFS). Consumed by the render worker.
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
# x264 constant-rate-factor: lower = better quality, bigger file.
# 18 = visually transparent (default); 20-23 = faster/smaller drafts.
RENDER_CRF=18
# x264 speed/efficiency trade-off: ultrafast..veryslow.
RENDER_PRESET=slow
# How a 16:9 broadcast source is fitted to 9:16:
#   auto = find the speaker and crop the frame around them, re-framing at
#          each cut (default; falls back to blur when no subject is found)
#   blur = blurred fill behind the fitted frame
#   crop = centre-crop to full bleed (ignores where the subject actually is)
#   pad  = plain black letterbox
RENDER_FRAMING=auto
RENDER_BLUR_SIGMA=30
# Source B-roll automatically when a clip is exported with none attached.
# Inserted assets remain editable/removable in the clip editor.
BROLL_AUTO_ON_EXPORT=true
# How B-roll is composited: pip (inset card) or fullscreen (cutaway).
RENDER_BROLL_MODE=pip
RENDER_PIP_WIDTH_RATIO=0.33
# Caption size and bottom margin as a fraction of frame height. The margin
# keeps burned-in captions clear of the YouTube Shorts UI overlay.
RENDER_CAPTION_SCALE=0.036
RENDER_CAPTION_MARGIN_RATIO=0.17
RENDER_CAPTION_FONT=DejaVu Sans
# Set captions in capitals, as a lot of short-form does.
RENDER_CAPTION_UPPERCASE=false
# Optional explicit font file for caption rendering; a known system font
# is auto-detected when left empty.
RENDER_CAPTION_FONT_FILE=
RENDER_AUDIO_BITRATE=192k
RENDER_AUDIO_LUFS=-14.0

# ---- Docker Compose only -------------------------------------------------------
# Host ports and API worker count for `docker compose up`.
API_PORT=8000
WEB_PORT=8080
POSTGRES_PORT=5432
WEB_CONCURRENCY=4
ENVIRONMENT=production
# JSON array; must include the origin the frontend is actually served from.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ---- Frontend ---------------------------------------------------------------
# Baked into the bundle at build time (Vite), not read at runtime.
VITE_API_URL=http://localhost:8000

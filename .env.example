# .env.example
# Copy to .env and fill in real values. Never commit the real .env file.

# ---- Database -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=videotoshorts
# Full connection string used by the backend. In docker-compose this is
# derived automatically from the POSTGRES_* vars above if left unset; set it
# explicitly for local (non-docker) development, e.g.:
# postgresql://postgres:change-me@localhost:5432/videotoshorts
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/videotoshorts

# ---- Auth / JWT -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Third-party media APIs (B-roll sourcing) -------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Transcription / speech-to-text ------------------------------------------
TRANSCRIPTION_API_KEY=

# ---- Object storage (uploaded videos, generated clips, exports) --------------
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- Background task queue (RQ + Redis) --------------------------------------
# Leave unset (default) to run video-processing/render jobs via FastAPI's
# own BackgroundTasks instead -- no Redis needed for local development.
REDIS_URL=

# ---- Frontend ---------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# .gitignore

# ---- Environment / secrets --------------------------------------------------
.env
.env.*
!.env.example

# ---- Python (backend) -------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv*/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
build/
dist/
*.coverage
.coverage.*
htmlcov/

# ---- Alembic ------------------------------------------------------------
# (migration scripts themselves ARE tracked; only local sqlite fallback DBs)
*.sqlite3

# ---- Node / frontend ------------------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Editor / OS cruft ------------------------------------------------------
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Uploaded / rendered media -------------------------------------------
# Source videos, rendered exports and poster frames are user data, not
# source code -- they belong on a volume/object store, never in git.
backend/uploads/

# ---- Logs ---------------------------------------------------------------
*.log
logs/
